<?xml version="1.0" encoding="utf-8"?>
<!--
  ابزارک فشرده — ۲×۲.

  نسخه قبل ۳×۲ بود با پنج عنصر: شعله، عدد، پیام، نوار پیشرفت، و زیرنویس
  امتیاز. روی صفحه خانه، نتیجه یک مستطیل بزرگِ کم‌رنگ بود که هیچ‌کدام از
  آن پنج چیز در آن دیده نمی‌شد.

  حالا دو عنصر: **شعله و عدد**. همان چیزی که ابزارک دولینگو دارد. نوار
  پیشرفت و پیام به نسخه پهن منتقل شدند؛ کسی که ابزارک ۲×۲ می‌گذارد،
  جا برای گزارش نگذاشته است.

  چرا عدد کنار شعله و نه زیرش: در چیدمان عمودی، هر دو کوچک می‌مانند تا
  در ارتفاع جا شوند. کنار هم، هر دو می‌توانند بزرگ باشند.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_flame"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/widget_description"
            android:src="@drawable/img_flame_off" />

        <!--
          عدد زنجیره.

          وقتی زنجیره صفر است این پنهان می‌شود و جایش «شروع کن» می‌آید:
          رقم صفر در فارسی «۰» است، یعنی یک نقطه — حتی در ۴۶sp هم روی
          صفحه خانه یک لکه ریز دیده می‌شد و ابزارک را خالی نشان می‌داد.
        -->
        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="54sp"
            android:fontFamily="@font/vazirmatn_extrabold"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="۵"
            android:textColor="#E8730C" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:fontFamily="@font/vazirmatn_semibold"
        android:maxLines="1"
        android:text="روز پشت‌سرهم"
        android:textColor="#8A7A63" />
</LinearLayout>
