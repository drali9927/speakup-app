<!--
  زمینه ابزارک.

  گرادیان کرمِ گرم با گوشه‌های ۲۸dp. روشن ماند و تیره نشد: ابزارک روی
  تصویرزمینه‌های تیره می‌نشیند و کارت روشن همان‌جا برجسته می‌شود — همان
  کاری که ابزارک دولینگو هم می‌کند.

  ایراد نسخه قبل روشنی‌اش نبود، خالی بودنش بود: پنج عنصر کم‌رنگ در یک
  کارت ۳×۲ که از دور شبیه یک مستطیل سفیدِ بی‌محتوا دیده می‌شد.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:startColor="#FFEFD2" android:endColor="#FFFDF8" android:angle="270" />
    <corners android:radius="28dp" />
    <!-- خط دور نازک: کارت روشن روی تصویرزمینه روشن، بدون آن لبه ندارد -->
    <stroke android:width="1dp" android:color="#F0E2C8" />
</shape>
